<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bluetooth Classic (SPP, the Mega) connects only to a device already
         paired via Android system settings — no active scanning/discovery.
         BLUETOOTH_SCAN is declared (with neverForLocation, so it doesn't drag
         in location) purely because the flutter_blue_classic plugin's own
         connect() implementation always requests it internally on API 31+ and
         has a bug where it crashes if that request isn't already granted (see
         BluetoothPermissions.ensureGranted).

         BLE (GATT, the ESP32 boards) DOES actively scan (flutter_blue_plus,
         see BluetoothConnectionService.startBleScan) — on API 31+ this is
         covered by the same BLUETOOTH_SCAN(neverForLocation) below, no extra
         permission needed. On API < 31, BLE scan results are only ever
         delivered if a location permission is also granted at runtime — this
         app's actual fleet is all API 31+ (Android 12+), so that runtime
         request isn't implemented; ACCESS_FINE_LOCATION is still declared
         below (capped to <=30) for manifest correctness, but BLE scanning
         will silently return nothing on an unsupported older device without
         also adding a runtime location-permission request. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />
    <application
        android:label="ARDMX"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false">
        <!-- Without this, Android's auto-backup silently restores this app's
             SharedPreferences (including DeviceIdentificationService's
             per-MAC device-type cache) after an uninstall+reinstall, on any
             phone with cloud backup enabled (observed on this project's own
             test phone) — making a "fresh install" not actually clear a
             stale/wrong cached device type, which is confusing during
             hardware bring-up when the same physical board's Bluetooth MAC
             gets reflashed with different firmware over time. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
